# Supabase: use a separate project for development/staging. Never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy key name is supported when the publishable key is absent.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Only the operator ingestion path uses this key. Customer requests use RLS.
SUPABASE_SERVICE_ROLE_KEY=
# At least 32 random characters. Never expose it with NEXT_PUBLIC_.
INGESTION_SECRET=

# Resume tailoring: an HTTPS OpenAI-compatible provider endpoint and explicit model.
# Local development may use a local provider; production must configure HTTPS.
TAILORING_BASE_URL=
TAILORING_MODEL=
# Set to none for a model confirmed to support disabling reasoning.
TAILORING_REASONING=
TAILORING_API_KEY=

# Boat + Browser Use application automation. Keep credentials server-only.
APPLICATION_BROWSER_PROVIDER=boat
BOAT_API_KEY=
# Batching is on for Boat after migration 202611120071. Set false to roll back.
BOAT_APPLICATION_BATCHING=true
# Optional prepared dependency template (not available on the Boat trial).
BOAT_BROWSER_SNAPSHOT=
# Browser Use owns all browser actions; no alternate field orchestration engine.
APPLICATION_FORM_PLANNER=browser-use
# Public job feeds use direct server-side HTTP requests.
# After migration 202610310005 and a reader-compatible release, archive public listing bodies.
CATALOG_CONTENT_ENABLED=false
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# After migrations 202611040050 and 202611070060-61: scheduled archive intake,
# live validation, collection and paid Search discovery. Isolated staging only.
# SQL caps archive attempts at 12/day, paid Search at 48 requests and $1/day.
AUTOMATIC_DISCOVERY_ENABLED=false
# Optional override for bounded scheduled candidate validation (1-50, default 14).
SOURCE_DISCOVERY_BATCH_SIZE=14
# Primary paid CAPTCHA grid solver, used immediately on detection; blank skips to Telegram.
TWOCAPTCHA_API_KEY=
# Synthetic employer harness: staging only, exact canonical origin. Leave blank in production.
APPLICATION_TEST_ORIGIN=
# The exact AI Gateway endpoint can instead use AI_GATEWAY_API_KEY locally
# or the automatic VERCEL_OIDC_TOKEN on Vercel. Tokens never go to other hosts.
AI_GATEWAY_API_KEY=

# Optional operator-only visa refinement (not customer resume generation).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional additional source coverage.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Vercel Cron: GET /api/cron/jobs, every six hours at 00:00/06:00/12:00/18:00 UTC. At least 32 random characters.
# Set in the Vercel production environment; never expose it to browser code.
CRON_SECRET=
# Customer-triggered, quota-limited refresh of verified employer boards.
# Apply migrations 202610300016 and 202610300017 before enabling.
ON_DEMAND_SEARCH_ENABLED=false

# Optional Telegram review channel. Apply migration 202611020038 before enabling.
TELEGRAM_ENABLED=false
TELEGRAM_APP_ORIGIN=
# Username without @, ending in bot. Obtain it from @BotFather.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Random secret sent by Telegram in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# Browser Use OSS Python worker (HTTPS service in deployed environments).
# Optional dedicated DOM-only browser planner model (inherits TAILORING_MODEL if empty).
BROWSER_USE_MODEL=
# Set both for a separate HTTPS model endpoint reachable from the worker.
BROWSER_USE_BASE_URL=
BROWSER_USE_API_KEY=
BROWSER_USE_WORKER_URL=
BROWSER_USE_WORKER_TOKEN=
# Local development alternative: absolute path to Python with workers/browser-use/requirements.txt installed.
BROWSER_USE_PYTHON=

# Firecrawl Alexandria contact suggestions on confirmed applications (server only).
FIRECRAWL_API_KEY=
