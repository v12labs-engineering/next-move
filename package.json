{
  "name": "job-search",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --port 3002",
    "build": "node scripts/build-boat-worker.mjs && next build --webpack && node scripts/check-function-bundles.mjs",
    "check:function-bundles": "node scripts/check-function-bundles.mjs",
    "start": "next start --port 3002",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "catalog:audit": "node --import tsx scripts/catalog/catalog.mjs audit",
    "catalog:collect": "node --import tsx scripts/catalog/catalog.mjs collect",
    "catalog:sources": "node --import tsx scripts/catalog/catalog.mjs sources",
    "catalog:linkedin": "node --import tsx scripts/catalog/linkedin-jobs.mjs",
    "catalog:discover": "node --import tsx scripts/catalog/discover-sources.mjs",
    "catalog:discover-browserbase": "node --import tsx scripts/catalog/discover-browserbase.mjs",
    "catalog:discover-worldwide": "node --import tsx scripts/catalog/discover-browserbase.mjs --worldwide",
    "catalog:discover-all": "node --import tsx scripts/catalog/discover-all-sources.mjs",
    "catalog:refresh-expanded": "node --import tsx scripts/catalog/refresh-expanded-catalog.mjs",
    "catalog:verify-discovery": "node --import tsx scripts/verify/verify-source-discovery.mjs",
    "smoke:auth": "node scripts/verify/smoke-auth.mjs",
    "staging:plan": "node scripts/staging/staging-check.mjs --plan",
    "staging:check": "node scripts/staging/staging-check.mjs",
    "staging:migrate": "node scripts/staging/staging-migrate.mjs",
    "staging:apply": "node scripts/staging/staging-migrate.mjs --apply",
    "staging:auth": "node scripts/staging/staging-auth.mjs",
    "pretest": "node scripts/build-boat-worker.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.80",
    "@browserbasehq/sdk": "^2.23.0",
    "@fontsource-variable/familjen-grotesk": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/oidc": "^3.2.0",
    "@workflow/world-postgres": "5.2.0",
    "ai": "^7.0.156",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.18.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.64.1",
    "radix-ui": "^1.6.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "read-excel-file": "^9.3.13",
    "saxes": "6.0.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^2.0.0",
    "workflow": "^5.2.3",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "esbuild": "0.28.1",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "undici@^7": "^7.30.1",
    "zod@^4": "$zod"
  }
}
